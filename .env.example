# Samaj Connect - example environment file
#
# Copy this to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit a real `.env`, a Firebase Admin
# service account JSON, or any private key to this repository.

# ---------------------------------------------------------------------------
# Server (server.ts)
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=3000

# development | production
NODE_ENV=development

# Firebase project whose ID tokens the server accepts. The server verifies
# tokens against Google's public keys, so no service account is needed here.
FIREBASE_PROJECT_ID=samaj-connect-6ad91

# Phone numbers granted admin roles, comma separated.
# Format: <10-digit phone>:<SUPER_ADMIN|MAIN_SAMAJ_ADMIN|SAMAJ_ADMIN>
ADMIN_ALLOWLIST=

# TURN server for audio/video calls. Leave empty to use public STUN only.
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Client (Vite build)
# ---------------------------------------------------------------------------
# WARNING: every REACT_APP_* and VITE_* value below is baked into the public
# browser bundle by vite.config.ts. Put only public configuration here.
# A secret placed in these variables is readable by anyone using the app.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=samaj-connect-6ad91.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=samaj-connect-6ad91
REACT_APP_FIREBASE_STORAGE_BUCKET=samaj-connect-6ad91.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Set to "true" only if Cloud Firestore should be used directly from the browser.
REACT_APP_ENABLE_FIRESTORE=false

VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Firebase Admin service account (only if server-side Admin SDK is added back)
# ---------------------------------------------------------------------------
# The current server does NOT need a service account. If one is ever required,
# keep the JSON file outside the repository and point at it by path - do not
# paste the key itself into this file and do not commit the JSON.
#
# GOOGLE_APPLICATION_CREDENTIALS=/etc/samaj-connect/firebase-admin.json
