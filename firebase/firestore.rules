rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isMod() { return me().role in ['super_admin', 'samaj_admin', 'admin', 'moderator']; }
    function canSee(d) {
      return d.createdBy == request.auth.uid
        || d.authorId == request.auth.uid
        || d.visibility in ['all_samaj', 'public']
        || (d.visibility == 'samaj' && d.samajId == me().activeSamajId)
        || (d.visibility == 'followers' && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + (d.authorId != null ? d.authorId : d.createdBy))))
        || (d.visibility == 'private' && (d.createdBy == request.auth.uid || (d.allowedUserIds != null && request.auth.uid in d.allowedUserIds)))
        || (d.visibility == 'only_me' && (d.createdBy == request.auth.uid || d.authorId == request.auth.uid))
        || isMod();
    }

    // All writes go through the backend (Admin SDK). Clients only get realtime READ access.
    // users: only own document readable by client (phone/tokens never exposed to other users)
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['online', 'lastSeen']);
    }
    match /conversations/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.memberIds;
        allow write: if false;
      }
    }
    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /liveSessions/{lid} {
      allow read: if signedIn() && canSee(resource.data);
      allow write: if false;
      match /chat/{mid} {
        allow read: if signedIn() && canSee(get(/databases/$(database)/documents/liveSessions/$(lid)).data);
        allow write: if false;
      }
      match /sessions/{sid} { allow read, write: if false; }
    }
    match /posts/{pid} {
      allow read: if signedIn() && canSee(resource.data) && resource.data.status == 'active';
      allow write: if false;
    }
    match /events/{eid} {
      allow read: if signedIn() && canSee(resource.data);
      allow write: if false;
    }
    match /samaj/{sid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /follows/{fid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /auditLogs/{lid} {
      allow read: if signedIn() && isMod();
      allow write: if false;
    }
    // persons, comments, stories, reports, groups, settings, albums, photos, halls, bookings: backend only
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
