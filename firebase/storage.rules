rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Strictly private uploads (only_me or private):
    // ONLY the authenticated owner can read or write.
    // Nobody else, signed in or not, can access these objects.
    match /uploads/{uid}/only_me/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 100 * 1024 * 1024;
    }
    match /uploads/{uid}/private/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 100 * 1024 * 1024;
    }

    // 2. Authenticated community uploads (reels, media, avatars, documents):
    // Only signed-in members of Samaj Connect can read;
    // unauthenticated/public internet users are STRICTLY DENIED.
    // Only the authenticated content owner can write (max 100MB).
    match /uploads/{uid}/{kind}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 100 * 1024 * 1024;
    }

    // Default fallback: only authenticated read, write denied
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}

